{
  "name": "hackathon-sbp-server",
  "version": "0.1.0",
  "private": true,
  "description": "Backend del reto SBP 2026: motor de rankings de crédito, exportaciones y pruebas",
  "type": "module",
  "scripts": {
    "start": "node src/servidor.js",
    "dev": "node --watch src/servidor.js",
    "test": "node --test \"tests/**/*.test.js\"",
    "test:cobertura": "node --test --experimental-test-coverage --test-coverage-exclude=\"tests/**\" --test-coverage-lines=90 --test-coverage-branches=85 --test-coverage-functions=90 \"tests/**/*.test.js\"",
    "procesar": "node scripts/procesar.js",
    "humo": "node scripts/humo.js",
    "mcp": "node src/mcp/index.js",
    "eval:agente": "node evals/agente/correr.js"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^1.14.0",
    "@modelcontextprotocol/sdk": "^1.32.2",
    "csv-parse": "^7.0.3",
    "express": "^5.3.0",
    "swagger-ui-express": "^5.0.1"
  }
}
