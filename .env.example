# Variables de entorno del proyecto. Copia este archivo a .env (en la raíz) y llena solo lo que necesites.
# Todo va vacío a propósito (regla R5: nunca credenciales en el repo). Una variable vacía usa su valor por defecto.
# `npm run dev` y `npm start` en la raíz cargan este .env (scripts/con-env.mjs); el client lo lee con Vite.

# --- Server · backend (Jesús, Juan) ---
# Puerto del API. Vacío: 3001.
PORT=
# Carpeta con los CSV AT03 y catálogos. Vacío: data/ en la raíz del repo.
DATA_DIR=
# Persistencia local (períodos cargados, bitácora, parámetros). Vacío: storage/ en la raíz del repo.
STORAGE_DIR=
# Archivo de parámetros que cambia el Administrador (#30). Vacío: parametros.json dentro de STORAGE_DIR.
PARAMETROS_FILE=

# --- IA para explorar y explicar · issues #2 y #3 (Agustín) ---
# Llave del API de Anthropic. Vacío: las funciones de IA quedan apagadas.
ANTHROPIC_API_KEY=
# Modelo de Claude. Vacío: el modelo por defecto del server.
AI_MODEL=

# --- Alertas por correo con Zapier · issue #7 (Jesús) ---
# Webhook de Zapier que recibe los eventos de la app (período publicado, suscripciones). Vacío: no se envía nada
# y el aviso queda en la bitácora como PENDIENTE. La URL se comparte por fuera del repo (R5).
ZAPIER_WEBHOOK_URL=

# --- Client · frontend (Agustín) ---
# true: el client responde con los ejemplos de /contracts sin llamar al API (solo en `npm run dev`). Vacío: false.
VITE_USAR_MOCKS=
# Destino del proxy /api del client en desarrollo. Vacío: http://localhost:3001.
API_URL=

# --- Docker · issue #27 (Juan) ---
# Puerto del host para el client en docker compose (docker-compose.override.yml). Vacío: 8080.
CLIENT_PORT=
